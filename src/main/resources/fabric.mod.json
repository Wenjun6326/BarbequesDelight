{
  "schemaVersion": 1,
  "id": "barbequesdelight",
  "version": "${version}",
  "name": "Barbeque's Delight",
  "description": "This mod adds some tasty BBQ skewers as well as a new grill!",
  "authors": [
    "MaoMao(Aomiaomao)"
  ],
  "contact": {
    "repo": "https://modrinth.com/mod/barbeques-delight",
    "homepage": "https://github.com/AOMIAOMAO/BarbequesDelight",
    "issues": "https://github.com/AOMIAOMAO/BarbequesDelight/issues"
  },
  "license": "MIT",
  "icon": "assets/barbequesdelight/icon.png",
  "environment": "*",
  "mixins": [
    "barbequesdelight.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "com.mao.barbequesdelight.BarbequesDelightClient"
    ],
    "main": [
      "com.mao.barbequesdelight.BarbequesDelight"
    ],
    "jade": [
      "com.mao.barbequesdelight.compat.jade.GrillJadePlugin"
    ],
    "jei_mod_plugin": [
      "com.mao.barbequesdelight.compat.jei.BBQDJeiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": "~26.1",
    "java": ">=25",
    "farmersdelight": ">=26.1-3.6.0"
  },
  "suggests": {
    "jade": "*",
    "jei": "*"
  }
}
